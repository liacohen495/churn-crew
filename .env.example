# Copy this file to .env and fill in ONE option. Never commit .env.

# Option A - free: Google Gemini (key from https://aistudio.google.com/apikey)
# Copy the exact model name from AI Studio and put "gemini/" in front of it.
GEMINI_API_KEY=
MODEL=gemini/PUT-MODEL-NAME-HERE

# Option B - paid (cents per run): OpenAI
# OPENAI_API_KEY=sk-...
# MODEL=openai/gpt-4o-mini
